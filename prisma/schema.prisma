
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum LeadWarmth {
  CURIOUS
  INTERESTED
  READY_NOW
}

enum NextStep {
  SEND_PRICING
  CALL_TOMORROW
  BOOK_MEETING
  JUST_A_NOTE
}

enum CatalogType {
  PRODUCT
  SERVICE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
}

model Lead {
  id           String      @id @default(cuid())
  personName   String?
  companyName  String?
  mobileNumber String
  email        String
  requirement  String
  nextStep     NextStep
  warmth       LeadWarmth
  createdAt    DateTime    @default(now())
  opportunity  Opportunity?
}

model CatalogItem {
  id            String        @id @default(cuid())
  name          String
  type          CatalogType
  description   String?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]

  @@unique([name, type])
}

model Opportunity {
  id                String      @id @default(cuid())
  leadId            String      @unique
  catalogItemId     String
  totalAmount       Decimal     @db.Decimal(12, 2)
  expectedMarginPct Decimal     @db.Decimal(5, 2)
  createdAt         DateTime    @default(now())

  lead        Lead        @relation(fields: [leadId], references: [id])
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id])
}
